+      labelAt: { q: 20, side: "above", gap: 26 },
+    },
+    {
+      id: "ppc-base",
+      label: "Original PPC",
+      kind: "points",
+      points: PPC_BASE,
+      domain: [0, 100],
+      color: "muted",
+      dash: true,
+      smooth: true,
+      eq: "through (0,150), (20,140), (40,125), (60,105), (80,70), (100,0)",
