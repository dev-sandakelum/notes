+
+const scalePts = (pts: [number, number][], k: number): [number, number][] =>
+  pts.map(([x, y]) => [x * k, y * k]);
+
+/** Growth: +20% on both axes. Decline: −20% on both axes. */
+export const PPC_GROWTH = scalePts(PPC_BASE, 1.2);
+export const PPC_DECLINE = scalePts(PPC_BASE, 0.8);
